{
  "expo": {
    "name": "Vatican Cake Point",
    "slug": "vatican-cake-point",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vaticancakeapp",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaticancakepoint.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F5"
      },
      "package": "com.vaticancakepoint.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "vaticancakeapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1154485-239a-43a0-86b1-81abdb222a75"
      }
    }
  }
}
